# codeforge configuration - copy to .env (docker compose reads it) or export as environment variables
# Every key is optional; defaults are shown.

# server
CODEFORGE_WORKERS=2
CODEFORGE_LOG_LEVEL=info
# public base URL used in generated links (empty = relative)
CODEFORGE_BASE_URL=
# comma separated CORS origins, empty disables CORS headers
CODEFORGE_CORS_ORIGINS=*

# abuse protection
# requests per client IP: 120/minute, 2000/hour, 10 per 5 minutes, 0 = off
CODEFORGE_RATE_LIMIT=120/minute
# identify clients by X-Forwarded-For / X-Real-IP (behind a reverse proxy)
CODEFORGE_TRUST_PROXY=true
CODEFORGE_MAX_DATA_LENGTH=4000
CODEFORGE_MAX_SCALE=30
CODEFORGE_MAX_BORDER=50
CODEFORGE_MAX_IMAGE_PIXELS=30000000
CODEFORGE_MAX_BATCH_ITEMS=200
CODEFORGE_MAX_UPLOAD_BYTES=10485760

# barcode engine
# persistent Ghostscript processes per uvicorn worker (0 = start gs per image via treepoem, ~1.5 s per barcode)
CODEFORGE_GS_WORKERS=2
CODEFORGE_GS_TIMEOUT=15
# in-memory result cache per uvicorn worker in bytes, 0 = off
CODEFORGE_CACHE_MAX_BYTES=67108864

# features
CODEFORGE_ENABLE_DECODER=true
CODEFORGE_ENABLE_BATCH=true
CODEFORGE_ENABLE_PLAYGROUND=true

# legacy: HTTP status for invalid /?bcid= requests (the original bwip-js service answered 500)
CODEFORGE_LEGACY_ERROR_STATUS=400
